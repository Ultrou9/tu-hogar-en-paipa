---
import type { Presentacion } from '../data/presentaciones';
import { etiquetaEstado } from '../data/presentaciones';
import Precio from './Precio.astro';

interface Props { tema: Presentacion }
const { tema } = Astro.props;
---

<article class="tarjeta">
  <a href={`/temas/${tema.slug}`} class="tapa">
    <div class="tapa-top">
      <span class="kicker">{tema.especialidad}</span>
      <span class={`chip chip--${tema.estado}`}>{etiquetaEstado[tema.estado]}</span>
    </div>
    <h3>{tema.titulo}</h3>
    <p class="sub">{tema.subtitulo}</p>
  </a>

  <dl class="datos">
    <div><dt>Secciones</dt><dd class="mono">{tema.secciones}</dd></div>
    <div><dt>Herramientas</dt><dd class="mono">{tema.herramientas.length}</dd></div>
    <div><dt>Evidencia</dt><dd>{tema.baseEvidencia[0]}</dd></div>
  </dl>

  <div class="pie-tarjeta">
    <div class="precio">
      {
        tema.estado === 'gratis' ? (
          <>
            <span class="precio-valor mono">Gratis</span>
            <span class="precio-nota">a cambio de tu correo</span>
          </>
        ) : tema.estado === 'produccion' ? (
          <>
            <span class="precio-valor mono">{tema.actualizado}</span>
            <span class="precio-nota">fecha prevista</span>
          </>
        ) : (
          <>
            <Precio nivel="temaSuelto" class="precio-valor mono" />
            <span class="precio-nota">kit de tres piezas</span>
          </>
        )
      }
    </div>
    <a href={`/temas/${tema.slug}`} class="ver">
      {tema.estado === 'produccion' ? 'Avisarme' : 'Ver el tema'} →
    </a>
  </div>
</article>

<style>
  .tarjeta {
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .tarjeta:hover { border-color: var(--teal-line); box-shadow: var(--shadow-lg); }

  .tapa {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px 16px;
    text-decoration: none;
    color: inherit;
  }
  .tapa-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .tapa h3 { font-size: 21px; }
  .sub { font-size: 14.6px; color: var(--text-2); }

  .datos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px 14px;
    margin: 0;
    padding: 13px 20px;
    border-block: 1px solid var(--line-soft);
    background: var(--panel);
  }
  .datos div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .datos dt {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .datos dd { margin: 0; font-size: 13.4px; color: var(--text); }

  .pie-tarjeta {
    margin-top: auto;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .precio { display: flex; flex-direction: column; }
  .precio :global(.precio-valor) { font-size: 16px; font-weight: 600; color: var(--text); }
  .precio-nota { font-size: 11.5px; color: var(--muted); }
  .ver { font-size: 14px; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .ver:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
