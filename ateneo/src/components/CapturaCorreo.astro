---
import { listaCorreo, sitio } from '../config';

interface Props {
  titulo?: string;
  texto?: string;
  etiquetaBoton?: string;
  /** Identificador para distinguir de dónde vino el contacto. */
  origen: string;
}

const {
  titulo = 'Llévate la revisión de insuficiencia cardiaca',
  texto = 'Las 15 secciones completas, con las 7 herramientas interactivas y la autoevaluación. Te la envío ahora mismo y te aviso cuando salga cada tema nuevo.',
  etiquetaBoton = 'Enviármela',
  origen,
} = Astro.props;

// Sin endpoint configurado el formulario cae a un mailto: nunca se pierde un
// contacto por tener a medias la integración de correo.
const configurado = Boolean(listaCorreo.endpoint);
const accion = configurado
  ? listaCorreo.endpoint
  : `mailto:${sitio.correoContacto}`;
const idCampo = `correo-${origen}`;
---

<section class="captura" aria-labelledby={`titulo-${origen}`}>
  <div class="captura-texto">
    <span class="eyebrow">Gratis</span>
    <h2 id={`titulo-${origen}`}>{titulo}</h2>
    <p>{texto}</p>
  </div>

  <div class="captura-lado">
    <form
      class="captura-form"
      data-captura
      action={accion}
      method={configurado ? 'post' : 'get'}
      enctype={configurado ? undefined : 'text/plain'}
    >
      <input type="hidden" name={listaCorreo.campoOrigen} value={origen} />
      {
        configurado && (
          <>
            <input type="hidden" name="ml-submit" value="1" />
            <input type="hidden" name="anticsrf" value="true" />
          </>
        )
      }
      <label for={idCampo}>Tu correo</label>
      <div class="fila">
        <input
          id={idCampo}
          type="email"
          name={listaCorreo.campoCorreo}
          required
          autocomplete="email"
          placeholder="tu@correo.com"
        />
        <button type="submit" class="boton boton--primario" data-enviar>{etiquetaBoton}</button>
      </div>
      <p class="nota">Un correo cuando sale un tema nuevo. Nada más. Te das de baja en un clic.</p>
      <p class="error" data-error hidden role="alert">
        No se ha podido enviar. Revisa la conexión e inténtalo otra vez.
      </p>
    </form>

    <div class="hecho" data-hecho hidden>
      <p class="hecho-titulo">Revisa tu correo</p>
      <p>
        Te acabo de mandar un mensaje con un enlace de confirmación. Pulsa ahí y
        te llega la presentación. Si no aparece en un par de minutos, mira en
        spam o en «promociones».
      </p>
    </div>
  </div>
</section>

<style>
  .captura {
    background: var(--rail-bg);
    color: var(--rail-text);
    padding: 34px;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 30px 40px;
    align-items: center;
  }
  .captura-texto { display: flex; flex-direction: column; gap: 9px; }
  .captura-texto h2 { font-size: clamp(22px, 3vw, 28px); color: #fff; }
  .captura-texto p { font-size: 15.3px; color: var(--rail-muted); max-width: 46ch; }

  .captura-form { display: flex; flex-direction: column; gap: 8px; }
  .captura-form label {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rail-muted);
  }
  .fila { display: flex; gap: 9px; flex-wrap: wrap; }
  .fila input {
    flex: 1 1 190px;
    min-width: 0;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--rail-line);
    border-radius: 3px;
    color: #fff;
  }
  .fila input::placeholder { color: var(--rail-muted); }
  .fila input:focus-visible { outline: 2px solid var(--teal); outline-offset: 1px; }
  .nota { font-size: 12.2px; color: var(--rail-muted); }
  .error { font-size: 12.8px; color: #ff9b9b; }

  .hecho {
    border: 1px solid var(--teal);
    background: rgba(255, 255, 255, 0.04);
    border-radius: 3px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .hecho-titulo { font-family: var(--serif); font-size: 20px; font-weight: 600; color: #fff; }
  .hecho p { font-size: 14.2px; color: var(--rail-muted); }
  .hecho p.hecho-titulo { color: #fff; }

  [hidden] { display: none !important; }

  @media (max-width: 780px) {
    .captura { grid-template-columns: 1fr; padding: 26px 22px; }
  }
</style>

<script>
  /*
    El endpoint de MailerLite responde JSON: si se enviara el formulario de la
    forma normal, el visitante acabaría mirando un volcado de datos en lugar de
    una confirmación. Así que se envía por detrás y se muestra el mensaje aquí.

    Sin JavaScript el formulario se envía igual y el alta se registra; solo se
    pierde la elegancia del mensaje final.
  */
  document.querySelectorAll<HTMLFormElement>('[data-captura]').forEach((form) => {
    if (!form.action.includes('mailerlite')) return;

    const boton = form.querySelector<HTMLButtonElement>('[data-enviar]');
    const error = form.querySelector<HTMLElement>('[data-error]');
    const hecho = form.parentElement?.querySelector<HTMLElement>('[data-hecho]');
    if (!boton || !error || !hecho) return;

    const textoOriginal = boton.textContent;

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      error.hidden = true;
      boton.disabled = true;
      boton.textContent = 'Enviando…';

      try {
        // El endpoint no devuelve cabeceras CORS, así que no se puede leer la
        // respuesta: 'no-cors' deja pasar la petición y el doble opt-in es
        // quien confirma de verdad que ha llegado.
        await fetch(form.action, {
          method: 'POST',
          mode: 'no-cors',
          body: new FormData(form),
        });
        form.hidden = true;
        hecho.hidden = false;
        hecho.setAttribute('tabindex', '-1');
        hecho.focus();
      } catch {
        error.hidden = false;
        boton.disabled = false;
        boton.textContent = textoOriginal;
      }
    });
  });
</script>
