---
import Base from '../../layouts/Base.astro';
import CapturaCorreo from '../../components/CapturaCorreo.astro';
import TarjetaTema from '../../components/TarjetaTema.astro';
import DemoIncrustada from '../../components/DemoIncrustada.astro';
import { presentaciones, etiquetaEstado } from '../../data/presentaciones';
import type { Presentacion } from '../../data/presentaciones';
import { sitio, precios, pagos } from '../../config';

export function getStaticPaths() {
  return presentaciones.map((tema) => ({
    params: { slug: tema.slug },
    props: { tema },
  }));
}

interface Props { tema: Presentacion }
const { tema } = Astro.props;

const relacionados = presentaciones
  .filter((p) => p.slug !== tema.slug && p.especialidad === tema.especialidad)
  .concat(presentaciones.filter((p) => p.slug !== tema.slug && p.especialidad !== tema.especialidad))
  .slice(0, 3);

const esGratis = tema.estado === 'gratis';
const enProduccion = tema.estado === 'produccion';
const hayCheckout = Boolean(tema.enlacePago || pagos.hotmartBase);

const descripcion = `${tema.titulo}: ${tema.subtitulo}. Revisión de tema en ${tema.secciones} secciones basada en ${tema.baseEvidencia.join(' y ')}, con ${tema.herramientas.length} herramientas interactivas. HTML, PowerPoint editable y handout en PDF.`;

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: `Revisión de tema: ${tema.titulo}`,
      description: descripcion,
      brand: { '@type': 'Brand', name: sitio.nombre },
      category: tema.especialidad,
      inLanguage: 'es',
      offers: {
        '@type': 'Offer',
        price: esGratis ? '0' : precios.temaSuelto.usd.replace(',', '.'),
        priceCurrency: 'USD',
        availability: enProduccion
          ? 'https://schema.org/PreOrder'
          : 'https://schema.org/InStock',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Catálogo', item: `${sitio.url}/catalogo` },
        { '@type': 'ListItem', position: 2, name: tema.titulo },
      ],
    },
  ],
};
---

<Base
  titulo={tema.titulo}
  descripcion={descripcion}
  ruta={`/temas/${tema.slug}`}
  datosEstructurados={datosEstructurados}
>
  <article>
    <section class="cabeza">
      <div class="contenedor">
        <nav class="miga" aria-label="Ruta">
          <a href="/catalogo">Catálogo</a>
          <span aria-hidden="true">/</span>
          <span>{tema.especialidad}</span>
        </nav>

        <div class="cabeza-grid">
          <div class="cabeza-texto">
            <span class={`chip chip--${tema.estado}`}>{etiquetaEstado[tema.estado]}</span>
            <h1>{tema.titulo}</h1>
            <p class="sub">{tema.subtitulo}</p>
            <p class="resumen">{tema.resumen}</p>
            <p class="rotacion"><span class="kicker">Se presenta en</span> {tema.rotacion}</p>
          </div>

          <aside class="compra" aria-label="Adquirir esta revisión">
            <dl class="ficha">
              <div><dt>Versión</dt><dd class="mono">v{tema.version}</dd></div>
              <div><dt>Actualizada</dt><dd>{tema.actualizado}</dd></div>
              <div><dt>Secciones</dt><dd class="mono">{tema.secciones}</dd></div>
              <div><dt>Herramientas</dt><dd class="mono">{tema.herramientas.length}</dd></div>
            </dl>

            <div class="base-evidencia">
              <span class="kicker">Basada en</span>
              <ul>{tema.baseEvidencia.map((g) => <li>{g}</li>)}</ul>
            </div>

            <div class="precio-bloque">
              {
                esGratis ? (
                  <>
                    <span class="precio mono">Gratis</span>
                    <span class="precio-nota">a cambio de tu correo</span>
                    <a href="/gratis" class="boton boton--primario boton--ancho">Recibirla ahora</a>
                  </>
                ) : enProduccion ? (
                  <>
                    <span class="precio mono">{tema.actualizado}</span>
                    <span class="precio-nota">fecha prevista de publicación</span>
                    <a href="/gratis" class="boton boton--primario boton--ancho">Avisarme cuando salga</a>
                  </>
                ) : (
                  <>
                    <span class="precio mono">{precios.temaSuelto.cop} COP</span>
                    <span class="precio-nota">≈ US$ {precios.temaSuelto.usd} · pago único</span>
                    <a
                      href={tema.enlacePago || pagos.hotmartBase || '/gratis'}
                      class="boton boton--primario boton--ancho"
                    >
                      {hayCheckout ? 'Comprar el kit completo' : 'Avisarme cuando esté a la venta'}
                    </a>
                    <p class="pago-nota">PSE, tarjeta, billeteras o en cuotas. Sin tarjeta internacional.</p>
                  </>
                )
              }
            </div>

            <ul class="incluye">
              {tema.incluye.map((i) => <li>{i}</li>)}
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {
      tema.demo && (
        <section class="demo">
          <div class="contenedor">
            <div class="demo-cabeza">
              <div>
                <span class="eyebrow">Demo en vivo</span>
                <h2>Pruébala antes de decidir</h2>
              </div>
              <a href={tema.demo} target="_blank" rel="noopener" class="boton boton--secundario">
                Abrir a pantalla completa
              </a>
            </div>
            <DemoIncrustada
              src={tema.demo}
              titulo={tema.titulo}
              version={tema.version}
              actualizado={tema.actualizado}
              alto={540}
            />
          </div>
        </section>
      )
    }

    <section class="seccion">
      <div class="contenedor dos-columnas">
        <div>
          <div class="seccion-cabeza">
            <span class="eyebrow">Temario</span>
            <h2>Las {tema.secciones} secciones</h2>
          </div>
          <ol class="temario">
            {tema.temario.map((t) => <li>{t}</li>)}
          </ol>
        </div>

        <div>
          <div class="seccion-cabeza">
            <span class="eyebrow">Interactividad</span>
            <h2>Lo que se puede tocar</h2>
            <p>
              No son ilustraciones. Se usan durante la exposición y responden con
              datos reales delante del auditorio.
            </p>
          </div>
          <ul class="herramientas">
            {tema.herramientas.map((h) => <li>{h}</li>)}
          </ul>

          <div class="aviso">
            <h3>Sobre las figuras</h3>
            <p>
              Todos los gráficos son de elaboración propia a partir de los datos
              publicados en las fuentes citadas. No se reproducen tablas ni figuras
              con derechos de autor de las guías originales.
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="contenedor bloque-captura">
      <CapturaCorreo origen={`tema-${tema.slug}`} />
    </div>

    <section class="seccion">
      <div class="contenedor">
        <div class="seccion-cabeza">
          <span class="eyebrow">Sigue</span>
          <h2>Otras revisiones</h2>
        </div>
        <div class="rejilla">
          {relacionados.map((t) => <TarjetaTema tema={t} />)}
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  .cabeza { padding-block: 34px 48px; border-bottom: 1px solid var(--line); }

  .miga { display: flex; gap: 8px; font-size: 13px; color: var(--muted); margin-bottom: 22px; }
  .miga a { color: var(--muted); text-decoration: none; }
  .miga a:hover { color: var(--teal); }

  .cabeza-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(280px, 1fr); gap: 40px; align-items: start; }
  .cabeza-texto { display: flex; flex-direction: column; gap: 13px; }
  .cabeza-texto h1 { font-size: clamp(31px, 5vw, 48px); letter-spacing: -0.015em; }
  .sub { font-size: clamp(17px, 2.3vw, 20px); color: var(--text-2); font-family: var(--serif); font-style: italic; }
  .resumen { font-size: 16.2px; color: var(--text-2); max-width: 58ch; }
  .rotacion { font-size: 14.4px; color: var(--text-2); display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; }

  /* ---- caja de compra ---- */
  .compra {
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    position: sticky;
    top: 84px;
  }
  .ficha { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin: 0; background: var(--line); border-bottom: 1px solid var(--line); }
  .ficha div { background: var(--panel); padding: 11px 14px; display: flex; flex-direction: column; gap: 2px; }
  .ficha dt { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .ficha dd { margin: 0; font-size: 14.6px; font-weight: 600; }

  .base-evidencia { padding: 14px 18px 0; display: flex; flex-direction: column; gap: 6px; }
  .base-evidencia ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .base-evidencia li { font-size: 14.2px; color: var(--text); }

  .precio-bloque { padding: 16px 18px; display: flex; flex-direction: column; gap: 5px; }
  .precio { font-size: 26px; font-weight: 600; line-height: 1.1; }
  .precio-nota { font-size: 12.6px; color: var(--muted); margin-bottom: 9px; }
  .pago-nota { font-size: 12.2px; color: var(--muted); margin-top: 3px; }

  .incluye { list-style: none; margin: 0; padding: 0 18px 18px; display: flex; flex-direction: column; gap: 8px; border-top: 1px solid var(--line-soft); padding-top: 14px; }
  .incluye li { font-size: 13.8px; color: var(--text-2); padding-left: 18px; position: relative; }
  .incluye li::before { content: "✓"; position: absolute; left: 0; color: var(--teal); font-weight: 600; }

  /* ---- demo ---- */
  .demo { padding-block: 46px; background: var(--panel); border-bottom: 1px solid var(--line); }
  .demo-cabeza { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .demo-cabeza h2 { font-size: clamp(22px, 3vw, 29px); margin-top: 6px; }

  /* ---- cuerpo ---- */
  .dos-columnas { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 44px; align-items: start; }

  .temario { margin: 0; padding-left: 0; list-style: none; counter-reset: sec; display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .temario li {
    counter-increment: sec;
    padding: 11px 0 11px 40px;
    border-bottom: 1px solid var(--line-soft);
    font-size: 15.4px;
    color: var(--text-2);
    position: relative;
  }
  .temario li::before {
    content: counter(sec, decimal-leading-zero);
    position: absolute;
    left: 0;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--crimson);
  }

  .herramientas { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
  .herramientas li {
    border: 1px solid var(--teal-line);
    background: var(--teal-soft);
    padding: 10px 14px;
    font-size: 14.8px;
    color: var(--text);
  }

  .aviso { margin-top: 26px; border-left: 2px solid var(--amber); background: var(--amber-soft); padding: 14px 16px; display: flex; flex-direction: column; gap: 6px; }
  .aviso h3 { font-size: 16px; color: var(--amber); }
  .aviso p { font-size: 14.2px; color: var(--text-2); }

  .bloque-captura { margin-block: 8px; }
  .rejilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(292px, 1fr)); gap: 16px; }

  @media (max-width: 900px) {
    .cabeza-grid { grid-template-columns: 1fr; gap: 30px; }
    .compra { position: static; }
  }
</style>
